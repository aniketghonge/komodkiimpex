# Example env file
# Add this to your local environment as .env.local (do NOT commit real secrets)

# Optional: a public base URL for Supabase storage (used on the frontend to load public images)
NEXT_PUBLIC_SUPABASE_STORAGE_URL=https://jgtsotoxfqbptrwtzkjc.supabase.co/storage/v1/object/public/Komodkiimpex/

# Server-side Supabase service role key (do not expose in client)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Mail (Nodemailer) - Gmail example (use app password for SMTP_PASS)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-gmail-app-password
FROM_EMAIL="Komodki Impex <your-email@gmail.com>"
TO_EMAIL=your-email@gmail.com
